{
  "name": "mirandaleyva/contao-popup-bundle",
  "description": "Popup/Overlay bundle for Contao",
  "type": "contao-bundle",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "contao/core-bundle": "^5.0"
  },
  "autoload": {
    "psr-4": {
      "MirandaLeyva\\ContaoPopupBundle\\": "src/"
    }
  },
  "extra": {
    "contao-manager-plugin": "MirandaLeyva\\ContaoPopupBundle\\ContaoManager\\Plugin"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
